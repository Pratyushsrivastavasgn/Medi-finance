# MediFinance Environment Configuration

# API Configuration
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME=MediFinance
VITE_APP_VERSION=1.0.0

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/medifinance
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# AWS Configuration (Optional)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=medifinance-documents

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@medifinance.health
SMTP_PASS=your-email-password

# External APIs
HOSPITAL_API_KEY=your-hospital-api-key
INSURANCE_API_KEY=your-insurance-api-key
NBFC_API_KEY=your-nbfc-api-key

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your-mixpanel-token

# Feature Flags
ENABLE_AI_PARSING=true
ENABLE_FINANCING=true
ENABLE_REAL_TIME_PRICING=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
